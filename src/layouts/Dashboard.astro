---
import '../styles/global.css';
import PawIcon from '../components/PawIcon.astro';

interface Props { title?: string; }
const { title = 'Dashboard — Patitas' } = Astro.props;
const path = Astro.url.pathname;

const navItems = [
  { href: '/dashboard', label: 'Resumen' },
  { href: '/dashboard/servicios', label: 'Servicios' },
  { href: '/dashboard/perros', label: 'Perros' },
  { href: '/dashboard/clientes', label: 'Clientes' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="app">
      <aside class="sidebar">
        <a href="/" class="brand">
          <PawIcon size={26} class="brand-mark" />
          <span class="brand-text">Patitas</span>
        </a>
        <nav class="sidebar-nav">
          {navItems.map(item => (
            <a href={item.href} class={`nav-item ${path === item.href ? 'active' : ''}`}>
              <span class="nav-dot" aria-hidden="true"></span>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="sidebar-footer">
          <div class="user-info">
            <div class="user-email">Sesión local</div>
          </div>
          <button id="logout-btn" class="btn btn-ghost logout-btn" type="button">Salir</button>
        </div>
      </aside>

      <main class="main-content">
        <slot />
      </main>
    </div>

    <script is:inline>
      const currentPath = window.location.pathname;
      const session = window.localStorage.getItem('patitas.auth.session');
      if (!session) {
        window.location.replace(`/login?next=${encodeURIComponent(currentPath + window.location.search)}`);
      }
      const logoutBtn = document.getElementById('logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', () => {
          window.localStorage.removeItem('patitas.auth.session');
          window.location.replace('/login');
        });
      }
    </script>

    <style>
      .app {
        display: grid;
        grid-template-columns: 260px 1fr;
        min-height: 100vh;
        background: var(--paper-2);
      }
      .sidebar {
        background: var(--paper);
        border-right: 1px solid var(--border);
        padding: 1.75rem 1.1rem;
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 0;
        height: 100vh;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-weight: 700;
        font-size: 1.25rem;
        color: var(--ink);
        margin-bottom: 2.5rem;
        text-decoration: none;
        letter-spacing: -0.02em;
      }
      .brand-mark { color: var(--ink); }
      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        flex: 1;
      }
      .nav-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        color: var(--gray-500);
        font-size: 0.93rem;
        font-weight: 500;
        transition: all 0.18s;
        position: relative;
      }
      .nav-item:hover {
        background: var(--paper-3);
        color: var(--ink);
      }
      .nav-item.active {
        background: var(--ink);
        color: var(--paper);
      }
      .nav-item.active .nav-dot { background: var(--paper); }
      .nav-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--gray-300);
        transition: background 0.18s;
      }
      .sidebar-footer {
        border-top: 1px solid var(--border);
        padding-top: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
      }
      .user-info { padding: 0 0.25rem; }
      .user-email {
        font-size: 0.78rem;
        color: var(--gray-400);
        word-break: break-all;
      }
      .logout-btn { font-size: 0.82rem; padding: 0.55rem 0.9rem; }
      .main-content { padding: 2.5rem 2.75rem; max-width: 100%; overflow-x: auto; }
      @media (max-width: 800px) {
        .app { grid-template-columns: 1fr; }
        .sidebar {
          position: static;
          height: auto;
          flex-direction: row;
          align-items: center;
          padding: 0.85rem 1rem;
        }
        .brand { margin-bottom: 0; margin-right: auto; font-size: 1.05rem; }
        .sidebar-nav {
          flex-direction: row;
          gap: 0.4rem;
          flex: 0;
        }
        .nav-item span:not(.nav-dot) { display: none; }
        .nav-item { padding: 0.55rem 0.7rem; }
        .nav-item.active .nav-dot { background: var(--ink); }
        .sidebar-footer { border: none; padding: 0; flex-direction: row; }
        .user-info { display: none; }
        .main-content { padding: 1.5rem 1rem; }
      }
    </style>
  </body>
</html>
