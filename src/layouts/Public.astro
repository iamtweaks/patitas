---
import '../styles/global.css';
interface Props { title?: string; }
const { title = 'Patitas — Peluquería canina' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="topnav">
      <div class="container nav-inner">
        <a href="/" class="brand">
          <span class="brand-mark">🐾</span>
          <span class="brand-text">Patitas</span>
        </a>
        <div class="nav-links">
          <a href="/" class={path === '/' ? 'active' : ''}>Inicio</a>
          <a href="/dashboard" class={path.startsWith('/dashboard') ? 'active' : ''}>Dashboard</a>
          <a href="/login" class="btn-mini">Entrar</a>
        </div>
      </div>
    </nav>

    <main><slot /></main>

    <footer>
      <div class="container footer-inner">
        <p>Patitas — peluquería y baño canino · Hecho con ❤</p>
      </div>
    </footer>

    <style>
      .topnav {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(14px);
        background: rgba(20, 36, 28, 0.78);
        border-bottom: 1px solid var(--border);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 700;
        font-size: 1.3rem;
        color: var(--bone);
      }
      .brand-mark { font-size: 1.5rem; }
      .brand-text { color: var(--amber); letter-spacing: 0.02em; }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.75rem;
      }
      .nav-links a:not(.btn-mini) {
        font-size: 0.92rem;
        font-weight: 500;
        color: var(--bone-dim);
      }
      .nav-links a:not(.btn-mini).active,
      .nav-links a:not(.btn-mini):hover { color: var(--amber); }
      .btn-mini {
        padding: 0.5rem 1.1rem;
        background: var(--grad-warm);
        color: var(--pine-deep);
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.88rem;
      }
      .btn-mini:hover { transform: translateY(-1px); box-shadow: var(--shadow-amber); }
      footer {
        margin-top: 5rem;
        padding: 2.5rem 0;
        border-top: 1px solid var(--border);
        background: rgba(20, 36, 28, 0.6);
      }
      .footer-inner { text-align: center; color: var(--bone-dim); font-size: 0.9rem; }
      @media (max-width: 600px) {
        .nav-links { gap: 1rem; }
        .nav-links a:not(.btn-mini):not(.active) { display: none; }
      }
    </style>
  </body>
</html>