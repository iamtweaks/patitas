---
import Public from '../layouts/Public.astro';

const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') ?? '/dashboard';
---
<Public title="Entrar — Patitas">
  <section class="auth-page">
    <div class="container container-narrow">
      <div class="card auth-card">
        <h1>🐾 Bienvenido a Patitas</h1>
        <p class="lead">Ingresá tu email y te mandamos un link mágico.</p>

        {error && (
          <div class="alert">⚠️ {error}</div>
        )}

        <form method="POST" action="/api/auth/login" class="auth-form">
          <input type="hidden" name="next" value={next} />
          <div class="field">
            <label for="email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="tu@email.com"
              required
              autocomplete="email"
            />
          </div>
          <button type="submit" class="btn btn-primary auth-btn">
            Mandame el link
          </button>
        </form>

        <p class="footer-note">
          ¿Sos nuevo? Creamos tu cuenta automáticamente la primera vez.
        </p>
      </div>
    </div>
  </section>
</Public>

<style>
  .auth-page { padding: 4rem 0; }
  .auth-card {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }
  .auth-card h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--bone);
  }
  .lead { margin-bottom: 2rem; }
  .alert {
    background: rgba(199, 93, 79, 0.15);
    border: 1px solid rgba(199, 93, 79, 0.4);
    color: #f4a89c;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    text-align: left;
  }
  .auth-form { text-align: left; }
  .auth-btn {
    width: 100%;
    margin-top: 0.5rem;
  }
  .footer-note {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--bone-dim);
  }
</style>