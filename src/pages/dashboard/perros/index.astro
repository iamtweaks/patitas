---
import Dashboard from '../../../layouts/Dashboard.astro';
import { getServerClient } from '../../../lib/supabase';

const supabase = getServerClient(Astro.cookies);
const [{ data: perros }, { data: clientes }] = await Promise.all([
  supabase.from('patitas_perros').select('*').order('nombre'),
  supabase.from('patitas_clientes').select('*').order('nombre')
]);

const perrosById: Record<string, any> = {};
(perros ?? []).forEach(p => { perrosById[p.id] = p; });
const clientesById: Record<string, any> = {};
(clientes ?? []).forEach(c => { clientesById[c.id] = c; });
---
<Dashboard title="Perros — Patitas">
  <header class="page-head">
    <div>
      <h1>Perros</h1>
      <p class="sub">{(perros ?? []).length} perros · {(clientes ?? []).length} clientes</p>
    </div>
    <a href="/dashboard/clientes" class="btn btn-ghost btn-sm">+ Nuevo cliente primero</a>
  </header>

  {(clientes ?? []).length === 0 ? (
    <div class="card empty-state">
      <h3>Necesitás un cliente primero</h3>
      <p>Antes de cargar un perro, cargá el dueño. <a href="/dashboard/clientes">Ir a clientes →</a></p>
    </div>
  ) : (
    <section class="layout">
      <div class="card form-card">
        <h3>➕ Registrar perro</h3>
        <form method="POST" action="/api/perros">
          <div class="field">
            <label for="cliente_id">Dueño *</label>
            <select id="cliente_id" name="cliente_id" required>
              <option value="">Seleccionar...</option>
              {(clientes ?? []).map(c => (
                <option value={c.id}>{c.nombre}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="nombre">Nombre del perro *</label>
            <input id="nombre" name="nombre" required placeholder="Firulais" />
          </div>
          <div class="field">
            <label for="raza">Raza *</label>
            <input id="raza" name="raza" required placeholder="Golden Retriever, Caniche, Mestizo..." />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="tamanio">Tamaño</label>
              <select id="tamanio" name="tamanio">
                <option value="">—</option>
                <option value="chico">Chico (hasta 10kg)</option>
                <option value="mediano">Mediano (10-25kg)</option>
                <option value="grande">Grande (25-40kg)</option>
                <option value="gigante">Gigante (+40kg)</option>
              </select>
            </div>
            <div class="field">
              <label for="peso_kg">Peso (kg)</label>
              <input id="peso_kg" name="peso_kg" type="number" step="0.1" placeholder="12.5" />
            </div>
          </div>
          <div class="field">
            <label for="fecha_nacimiento">Fecha de nacimiento</label>
            <input id="fecha_nacimiento" name="fecha_nacimiento" type="date" />
          </div>
          <div class="field">
            <label for="notas">Notas</label>
            <textarea id="notas" name="notas" rows="2" placeholder="Alergias, comportamiento, etc."></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Registrar perro</button>
        </form>
      </div>

      <div class="card list-card">
        <h3>Todos los perros</h3>
        {(perros ?? []).length === 0 ? (
          <p class="empty">Sin perros todavía.</p>
        ) : (
          <table class="table">
            <thead>
              <tr><th>Perro</th><th>Raza</th><th>Tamaño</th><th>Dueño</th></tr>
            </thead>
            <tbody>
              {(perros ?? []).map(p => (
                <tr>
                  <td><strong>{p.nombre}</strong></td>
                  <td>{p.raza}</td>
                  <td>{p.tamanio ? <span class="tag">{p.tamanio}</span> : '—'}</td>
                  <td>{clientesById[p.cliente_id]?.nombre ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </section>
  )}
</Dashboard>

<style>
  .page-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
  }
  .page-head h1 { font-size: 1.8rem; color: var(--bone); margin-bottom: 0.2rem; }
  .sub { color: var(--bone-dim); font-size: 0.92rem; }
  .btn-sm { padding: 0.5rem 1rem; font-size: 0.85rem; }

  .layout {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }

  .form-card h3, .list-card h3 { margin-bottom: 1rem; color: var(--bone); font-size: 1.05rem; }
  .empty { color: var(--bone-dim); padding: 1rem 0; text-align: center; }
  .empty-state { text-align: center; padding: 2rem 1rem; }
  .empty-state h3 { color: var(--amber); margin-bottom: 0.5rem; }
</style>