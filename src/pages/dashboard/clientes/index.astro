---
import Dashboard from '../../../layouts/Dashboard.astro';
import { getServerClient } from '../../../lib/supabase';

const supabase = getServerClient(Astro.cookies);
const { data: clientes } = await supabase
  .from('patitas_clientes')
  .select('*')
  .order('nombre', { ascending: true });

const editing = Astro.url.searchParams.get('edit');
let editCliente = null;
if (editing) {
  const { data } = await supabase
    .from('patitas_clientes')
    .select('*')
    .eq('id', editing)
    .single();
  editCliente = data;
}
---
<Dashboard title="Clientes — Patitas">
  <header class="page-head">
    <h1>Clientes</h1>
    <p class="sub">{(clientes ?? []).length} clientes registrados</p>
  </header>

  <section class="layout">
    <div class="card form-card">
      <h3>{editCliente ? '✏️ Editar cliente' : '➕ Nuevo cliente'}</h3>
      <form method="POST" action="/api/clientes">
        {editCliente && <input type="hidden" name="id" value={editCliente.id} />}
        <div class="field">
          <label for="nombre">Nombre *</label>
          <input id="nombre" name="nombre" required value={editCliente?.nombre ?? ''} placeholder="Juan Pérez" />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="telefono">Teléfono</label>
            <input id="telefono" name="telefono" value={editCliente?.telefono ?? ''} placeholder="+54 11 1234-5678" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" value={editCliente?.email ?? ''} placeholder="juan@mail.com" />
          </div>
        </div>
        <div class="field">
          <label for="notas">Notas</label>
          <textarea id="notas" name="notas" rows="2" placeholder="Alergias, preferencias, etc.">{editCliente?.notas ?? ''}</textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">{editCliente ? 'Guardar cambios' : 'Crear cliente'}</button>
          {editCliente && <a href="/dashboard/clientes" class="btn btn-ghost">Cancelar</a>}
        </div>
      </form>
    </div>

    <div class="card list-card">
      <h3>Listado</h3>
      {(clientes ?? []).length === 0 ? (
        <p class="empty">Todavía no cargaste ningún cliente. Empezá por la izquierda.</p>
      ) : (
        <table class="table">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Contacto</th>
              <th>Notas</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {(clientes ?? []).map(c => (
              <tr>
                <td><strong>{c.nombre}</strong></td>
                <td>
                  {c.telefono && <div>📞 {c.telefono}</div>}
                  {c.email && <div>✉️ {c.email}</div>}
                </td>
                <td class="notas">{c.notas ?? '—'}</td>
                <td class="actions">
                  <a href={`/dashboard/clientes?edit=${c.id}`} class="btn-mini-action">Editar</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </section>
</Dashboard>

<style>
  .page-head { margin-bottom: 1.5rem; }
  .page-head h1 { font-size: 1.8rem; color: var(--bone); margin-bottom: 0.2rem; }
  .sub { color: var(--bone-dim); font-size: 0.92rem; }

  .layout {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }

  .form-card h3, .list-card h3 { margin-bottom: 1rem; color: var(--bone); font-size: 1.05rem; }
  .form-actions { display: flex; gap: 0.5rem; margin-top: 0.5rem; }

  .empty { color: var(--bone-dim); font-size: 0.9rem; padding: 1rem 0; text-align: center; }
  .notas { font-size: 0.85rem; max-width: 250px; }
  .actions { text-align: right; }
  .btn-mini-action {
    font-size: 0.78rem;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    background: rgba(217, 142, 62, 0.15);
    color: var(--amber);
    border: 1px solid rgba(217, 142, 62, 0.3);
  }
  .btn-mini-action:hover { background: rgba(217, 142, 62, 0.3); }
</style>