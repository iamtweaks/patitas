---
import Dashboard from '../../../layouts/Dashboard.astro';
import { getServerClient } from '../../../lib/supabase';

const supabase = getServerClient(Astro.cookies);
const [{ data: servicios }, { data: perros }, { data: clientes }] = await Promise.all([
  supabase.from('patitas_servicios').select('*').order('fecha', { ascending: false }).order('created_at', { ascending: false }).limit(50),
  supabase.from('patitas_perros').select('*'),
  supabase.from('patitas_clientes').select('*')
]);

const perrosById: Record<string, any> = {};
(perros ?? []).forEach(p => { perrosById[p.id] = p; });
const clientesById: Record<string, any> = {};
(clientes ?? []).forEach(c => { clientesById[c.id] = c; });

const tipoLabel = (t: string) => {
  switch (t) {
    case 'bano': return { text: 'Baño', cls: 'tag-bano' };
    case 'corte': return { text: 'Corte', cls: 'tag-corte' };
    case 'bano_y_corte': return { text: 'Baño + Corte', cls: 'tag-completo' };
    default: return { text: 'Otro', cls: 'tag-otro' };
  }
};

const formatMoney = (n: number) => new Intl.NumberFormat('es-AR', {
  style: 'currency', currency: 'ARS', maximumFractionDigits: 0
}).format(n);
---
<Dashboard title="Servicios — Patitas">
  <header class="page-head">
    <h1>Servicios</h1>
    <p class="sub">{(servicios ?? []).length} registrados</p>
  </header>

  {(perros ?? []).length === 0 ? (
    <div class="card empty-state">
      <h3>Necesitás un perro primero</h3>
      <p>Antes de cargar un servicio, cargá al menos un perro. <a href="/dashboard/perros">Ir a perros →</a></p>
    </div>
  ) : (
    <>
      <section class="card form-card">
        <h3>➕ Registrar servicio</h3>
        <form method="POST" action="/api/servicios" class="service-form">
          <div class="field-row">
            <div class="field">
              <label for="perro_id">Perro *</label>
              <select id="perro_id" name="perro_id" required>
                <option value="">Seleccionar...</option>
                {(perros ?? []).map(p => {
                  const cliente = clientesById[p.cliente_id];
                  return (
                    <option value={p.id}>{p.nombre} ({p.raza}) — {cliente?.nombre ?? '—'}</option>
                  );
                })}
              </select>
            </div>
            <div class="field">
              <label for="fecha">Fecha *</label>
              <input id="fecha" name="fecha" type="date" required value={new Date().toISOString().slice(0, 10)} />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="tipo">Tipo *</label>
              <select id="tipo" name="tipo" required>
                <option value="bano">Baño</option>
                <option value="corte">Corte</option>
                <option value="bano_y_corte">Baño + Corte</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div class="field">
              <label for="precio">Precio (ARS) *</label>
              <input id="precio" name="precio" type="number" min="0" step="100" required placeholder="5000" />
            </div>
          </div>
          <div class="field">
            <label for="notas">Notas (opcional)</label>
            <textarea id="notas" name="notas" rows="2" placeholder="Corte de uñas, shampoo antipulgas, etc."></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Registrar servicio</button>
        </form>
      </section>

      <section class="card list-card">
        <h3>Historial reciente</h3>
        {(servicios ?? []).length === 0 ? (
          <p class="empty">Sin servicios registrados todavía.</p>
        ) : (
          <table class="table">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Perro</th>
                <th>Dueño</th>
                <th>Tipo</th>
                <th>Precio</th>
              </tr>
            </thead>
            <tbody>
              {(servicios ?? []).map(s => {
                const perro = perrosById[s.perro_id];
                const cliente = perro ? clientesById[perro.cliente_id] : null;
                const t = tipoLabel(s.tipo);
                return (
                  <tr>
                    <td>{s.fecha}</td>
                    <td><strong>{perro?.nombre ?? '—'}</strong><br /><span class="raza-small">{perro?.raza ?? ''}</span></td>
                    <td>{cliente?.nombre ?? '—'}</td>
                    <td><span class={`tag ${t.cls}`}>{t.text}</span></td>
                    <td class="price">{formatMoney(Number(s.precio))}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )}
      </section>
    </>
  )}
</Dashboard>

<style>
  .page-head { margin-bottom: 1.5rem; }
  .page-head h1 { font-size: 1.8rem; color: var(--bone); margin-bottom: 0.2rem; }
  .sub { color: var(--bone-dim); font-size: 0.92rem; }

  .form-card { margin-bottom: 1.25rem; }
  .form-card h3, .list-card h3 { margin-bottom: 1rem; color: var(--bone); font-size: 1.05rem; }

  .empty { color: var(--bone-dim); padding: 1rem 0; text-align: center; }
  .empty-state { text-align: center; padding: 2rem 1rem; }
  .empty-state h3 { color: var(--amber); margin-bottom: 0.5rem; }

  .raza-small { font-size: 0.78rem; color: var(--bone-dim); }
  .price {
    text-align: right;
    font-weight: 700;
    color: var(--amber);
  }
</style>