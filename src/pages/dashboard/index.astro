---
import Dashboard from '../../layouts/Dashboard.astro';
import { getServerClient } from '../../lib/supabase';

const supabase = getServerClient(Astro.cookies);

// All data for the current user
const [{ data: servicios }, { data: perros }, { data: clientes }] = await Promise.all([
  supabase.from('patitas_servicios').select('*').order('fecha', { ascending: false }),
  supabase.from('patitas_perros').select('*'),
  supabase.from('patitas_clientes').select('*')
]);

const now = new Date();
const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);

const serviciosMes = (servicios ?? []).filter(s => new Date(s.fecha) >= startOfMonth);
const serviciosAll = servicios ?? [];

const gananciaTotal = serviciosAll.reduce((sum, s) => sum + Number(s.precio || 0), 0);
const gananciaMes = serviciosMes.reduce((sum, s) => sum + Number(s.precio || 0), 0);

const counts = {
  banos: serviciosAll.filter(s => s.tipo === 'bano').length,
  cortes: serviciosAll.filter(s => s.tipo === 'corte').length,
  completos: serviciosAll.filter(s => s.tipo === 'bano_y_corte').length,
  otros: serviciosAll.filter(s => s.tipo === 'otro').length
};

// Per-day revenue for last 30 days
const last30: { day: string; total: number }[] = [];
for (let i = 29; i >= 0; i--) {
  const d = new Date();
  d.setDate(d.getDate() - i);
  const dayStr = d.toISOString().slice(0, 10);
  const total = serviciosAll
    .filter(s => s.fecha === dayStr)
    .reduce((sum, s) => sum + Number(s.precio || 0), 0);
  last30.push({ day: dayStr.slice(5), total });
}

// Per-month revenue for last 6 months
const last6: { month: string; total: number }[] = [];
for (let i = 5; i >= 0; i--) {
  const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
  const key = d.toISOString().slice(0, 7); // YYYY-MM
  const total = serviciosAll
    .filter(s => s.fecha.startsWith(key))
    .reduce((sum, s) => sum + Number(s.precio || 0), 0);
  last6.push({
    month: d.toLocaleDateString('es-AR', { month: 'short' }),
    total
  });
}

// Top dogs (most serviced)
const perroCount: Record<string, number> = {};
serviciosAll.forEach(s => { perroCount[s.perro_id] = (perroCount[s.perro_id] || 0) + 1; });
const topPerros = Object.entries(perroCount)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 5)
  .map(([perroId, count]) => {
    const perro = (perros ?? []).find(p => p.id === perroId);
    const cliente = perro ? (clientes ?? []).find(c => c.id === perro.cliente_id) : null;
    return {
      name: perro?.nombre ?? 'Desconocido',
      cliente: cliente?.nombre ?? '—',
      count
    };
  });

// Raza distribution (top 5)
const razaCount: Record<string, number> = {};
(perros ?? []).forEach(p => { if (p.raza) razaCount[p.raza] = (razaCount[p.raza] || 0) + 1; });
const topRazas = Object.entries(razaCount).sort(([, a], [, b]) => b - a).slice(0, 5);

const max30 = Math.max(1, ...last30.map(d => d.total));
const max6 = Math.max(1, ...last6.map(d => d.total));

const formatMoney = (n: number) => new Intl.NumberFormat('es-AR', {
  style: 'currency', currency: 'ARS', maximumFractionDigits: 0
}).format(n);
---
<Dashboard title="Resumen — Patitas">
  <header class="page-head">
    <h1>Hola, <span class="hl">Patitas</span> 👋</h1>
    <p class="sub">Acá tenés el pulso de tu peluquería.</p>
  </header>

  <div class="kpis">
    <div class="card kpi">
      <div class="kpi-label">Ganancia del mes</div>
      <div class="kpi-value">{formatMoney(gananciaMes)}</div>
      <div class="kpi-sub">{serviciosMes.length} servicios</div>
    </div>
    <div class="card kpi">
      <div class="kpi-label">Ganancia total</div>
      <div class="kpi-value">{formatMoney(gananciaTotal)}</div>
      <div class="kpi-sub">{serviciosAll.length} servicios totales</div>
    </div>
    <div class="card kpi">
      <div class="kpi-label">Clientes activos</div>
      <div class="kpi-value">{(clientes ?? []).length}</div>
      <div class="kpi-sub">{(perros ?? []).length} perros registrados</div>
    </div>
    <div class="card kpi">
      <div class="kpi-label">Baños / Cortes / Completos</div>
      <div class="kpi-value-sm">{counts.banos} / {counts.cortes} / {counts.completos}</div>
      <div class="kpi-sub">+ {counts.otros} otros</div>
    </div>
  </div>

  <section class="charts">
    <div class="card">
      <h3>Ganancia últimos 30 días</h3>
      <div class="chart-bars">
        {last30.map(d => (
          <div class="bar-col" title={`${d.day}: ${formatMoney(d.total)}`}>
            <div class="bar" style={`height: ${Math.max(2, (d.total / max30) * 100)}%`}></div>
          </div>
        ))}
      </div>
    </div>

    <div class="card">
      <h3>Ganancia últimos 6 meses</h3>
      <div class="chart-bars">
        {last6.map(d => (
          <div class="bar-col wide" title={`${d.month}: ${formatMoney(d.total)}`}>
            <div class="bar bar-amber" style={`height: ${Math.max(2, (d.total / max6) * 100)}%`}></div>
            <span class="bar-label">{d.month}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="rankings">
    <div class="card">
      <h3>🏆 Perros más frecuentes</h3>
      {topPerros.length === 0 ? (
        <p class="empty">Sin servicios registrados todavía.</p>
      ) : (
        <table class="table">
          <thead><tr><th>Perro</th><th>Dueño</th><th>Visitas</th></tr></thead>
          <tbody>
            {topPerros.map(p => (
              <tr>
                <td><strong>{p.name}</strong></td>
                <td>{p.cliente}</td>
                <td><span class="tag">{p.count}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

    <div class="card">
      <h3>🐕 Razas más comunes</h3>
      {topRazas.length === 0 ? (
        <p class="empty">Sin perros registrados todavía.</p>
      ) : (
        <ul class="raza-list">
          {topRazas.map(([raza, count]) => (
            <li>
              <span class="raza-name">{raza}</span>
              <span class="raza-count">{count}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  {serviciosAll.length === 0 && (
    <div class="card empty-state">
      <h3>Empezá con tu primer servicio</h3>
      <p>Todavía no registraste ningún baño ni corte. Andá a la sección <a href="/dashboard/servicios">Servicios</a> para cargar el primero.</p>
    </div>
  )}
</Dashboard>

<style>
  .page-head { margin-bottom: 2rem; }
  .page-head h1 {
    font-size: 2rem;
    margin-bottom: 0.3rem;
    color: var(--bone);
  }
  .page-head .hl { color: var(--amber); }
  .page-head .sub { font-size: 1rem; }

  .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .kpi-label {
    font-size: 0.78rem;
    color: var(--sage);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .kpi-value {
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--amber);
    line-height: 1;
    margin-bottom: 0.3rem;
  }
  .kpi-value-sm {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--amber);
    line-height: 1.2;
    margin-bottom: 0.3rem;
  }
  .kpi-sub { font-size: 0.82rem; color: var(--bone-dim); }

  .charts {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 800px) { .charts { grid-template-columns: 1fr; } }
  .charts h3 { margin-bottom: 1rem; color: var(--bone); font-size: 1.05rem; }

  .chart-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 140px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 4px;
  }
  .bar-col {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
    position: relative;
  }
  .bar-col.wide { min-width: 50px; }
  .bar {
    width: 100%;
    background: var(--sage);
    border-radius: 3px 3px 0 0;
    min-height: 2px;
    transition: height 0.4s;
  }
  .bar-amber { background: var(--amber); }
  .bar-label {
    position: absolute;
    bottom: -20px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.7rem;
    color: var(--bone-dim);
  }

  .rankings {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 800px) { .rankings { grid-template-columns: 1fr; } }
  .rankings h3 { margin-bottom: 1rem; color: var(--bone); font-size: 1.05rem; }

  .empty, .empty-state { padding: 1rem 0; }
  .empty-state { text-align: center; padding: 2rem 1rem; margin-top: 1.5rem; }
  .empty-state h3 { color: var(--amber); margin-bottom: 0.5rem; }

  .raza-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .raza-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.7rem;
    background: rgba(245, 239, 230, 0.04);
    border-radius: 6px;
  }
  .raza-name { font-weight: 500; color: var(--bone); }
  .raza-count {
    background: rgba(123, 160, 122, 0.2);
    color: var(--sage);
    padding: 0.2em 0.7em;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
  }
</style>