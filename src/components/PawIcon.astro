---
// Brand icon — paw print SVG, ink color, optional animation class
interface Props {
  size?: number;
  class?: string;
  animated?: boolean;
}
const { size = 24, class: className = '', animated = false } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class={`paw-icon ${className} ${animated ? 'paw-icon--animated' : ''}`}
  fill="currentColor"
  aria-hidden="true"
>
  <path d="M22 36c-4.4 0-8 3.4-8 7.5 0 3.5 3 6.5 7 6.5h22c4 0 7-3 7-6.5 0-4.1-3.6-7.5-8-7.5H22z"/>
  <ellipse cx="18" cy="22" rx="4.2" ry="5.8" transform="rotate(-18 18 22)"/>
  <ellipse cx="28" cy="16" rx="4.2" ry="5.8" transform="rotate(-6 28 16)"/>
  <ellipse cx="38" cy="16" rx="4.2" ry="5.8" transform="rotate(6 38 16)"/>
  <ellipse cx="48" cy="22" rx="4.2" ry="5.8" transform="rotate(18 48 22)"/>
</svg>

<style>
  .paw-icon {
    display: inline-block;
    vertical-align: middle;
    color: currentColor;
  }
  .paw-icon--animated {
    animation: drift 4s ease-in-out infinite;
    transform-origin: center;
  }
</style>
